{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "task_id",
    "generated_at",
    "status",
    "summary",
    "suspected_c2_entity_ids",
    "attack_chain",
    "attribution",
    "evidence_event_ids",
    "evidence_alert_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "initial_access_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "suspected_c2_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attack_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "tactic",
          "title",
          "description",
          "entity_ids",
          "evidence_event_ids",
          "evidence_alert_ids",
          "confidence"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "tactic": {
            "type": "string"
          },
          "technique_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "technique_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_alert_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "attribution": {
      "type": "object"
    },
    "evidence_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_alert_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
