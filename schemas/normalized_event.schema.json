{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "timestamp",
    "source_type",
    "source",
    "action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "enum": [
        "host_log",
        "host_behavior",
        "network_flow",
        "boundary_log"
      ]
    },
    "source": {
      "type": "string"
    },
    "host_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "src_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "src_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "dst_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "dst_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "process": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ppid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "object": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "network": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes_in": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bytes_out": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "raw_event": {},
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
