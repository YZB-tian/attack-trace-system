[Unit]
Description=AttackTraceLab SMTP evidence service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/attacktrace-smtp
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/attacktrace /var/spool/attacktrace-mail

[Install]
WantedBy=multi-user.target
