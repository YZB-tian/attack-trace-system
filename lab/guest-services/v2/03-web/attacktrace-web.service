[Unit]
Description=AttackTraceLab HTTP evidence service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/attacktrace-web
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/attacktrace

[Install]
WantedBy=multi-user.target
