APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# LLM configuration (optional)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Model calls are explicit via scripts/review_deepseek.py, never on page refresh.
# Optional local result file consumed by the backend (set in its environment):
# ATS_LLM_REVIEW_FILE=D:/build/attack-trace-system/runtime/deepseek-review.json

# Database (future)
DATABASE_URL=sqlite:///./runtime/attack_trace.db
